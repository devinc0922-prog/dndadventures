rules_version = '2';
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// Who gets in is decided by the members collection (doc id = lowercase Google email),
// so no email addresses need to live in this public repository.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function memberPath() { return /databases/$(database)/documents/members/$(email()); }
    function isMember() { return signedIn() && exists(memberPath()); }
    function isDM() { return isMember() && get(memberPath()).data.role == 'dm'; }

    // The party list. Members can see it; only the DM can change it.
    match /members/{memberEmail} {
      allow read: if isMember();
      allow write: if isDM();
    }

    // Characters. Every member can view every sheet.
    // Owners edit their own; the DM can edit or delete any.
    match /characters/{characterId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.owner == email();
      allow update: if isDM()
        || (isMember() && resource.data.owner == email() && request.resource.data.owner == email());
      allow delete: if isDM() || (isMember() && resource.data.owner == email());
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
